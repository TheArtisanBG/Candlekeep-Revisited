IF
    True()
THEN
    RESPONSE #100
        CutSceneId("Ulraunt")
        SetAreaScript("C0CR#SKU",OVERRIDE)
        SetGlobal("C0CR_ULR_SKIP","GLOBAL",1)
        SetCutSceneBreakable(TRUE)
        MoveViewObject(Player1,INSTANT)
		Wait(2)
		MoveToPoint([2608.1682])
		Wait(2)
		Unlock("Door2608")
		OpenDoor("Door2608")
		Wait(1)
		JumpToPoint([-1.-1])
		Wait(1)
		CloseDoor("Door2608")
		Lock("Door2608")
		Wait(2)
		SetCutSceneBreakable(FALSE)
		SetGlobal("C0CR_ULR_SKIP","GLOBAL",0)
		SetAreaScript("",OVERRIDE)
		ActionOverride("Gorion",StartDialogueNoSet(Player1))
		DestroySelf()
END
