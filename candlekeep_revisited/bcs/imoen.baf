IF
	Global("Chapter","GLOBAL",0)
	OR(2)
	Dead("shank")
	Dead("carbos")
	InParty(Myself)
	Global("C0CandleReImoenAssassin","GLOBAL",0)
THEN
  RESPONSE #100
	SetGlobal("C0CandleReImoenAssassin","GLOBAL",1)
	StartDialogueNoSet(Player1)
END

IF
	Global("Chapter","GLOBAL",0)
	OR(2)
	Dead("shank")
	Dead("carbos")
	!InParty(Myself)
	Global("C0CandleReImoenAssassin","GLOBAL",0)
THEN
  RESPONSE #100
	SetGlobal("C0CandleReImoenAssassin","GLOBAL",-1)
END
	
// Custom fix: once Chapter 1 starts, the temporary Candlekeep Imoen (the only Imoen with
// C0CandleReImoenJoined set, because she joined in Candlekeep) removes herself, leaving the
// real Imoen untouched to walk over, say "Sorry I followed ya..." and join as in the base game.
// The old handoff here ran on the real Imoen instead and ended with her DestroySelf(); on EET both
// Imoens share the death variable IMOEN2, so its MoveGlobalObject could not tell them apart.
IF
	Global("C0CandleReImoenJoined","LOCALS",1)
	GlobalGT("Chapter","GLOBAL",0)
	!InParty(Myself)
THEN
  RESPONSE #100
	SetGlobal("C0CandleReImoenAssassin","GLOBAL",2)  // Candlekeep-only talk; don't let it pre-empt the real Imoen's greeting
	DestroySelf()
END
	
IF
	InParty(Myself)
	Global("C0CandleReImoenJoins","GLOBAL",4)
THEN
  RESPONSE #100
	SetGlobal("C0CandleReImoenJoins","GLOBAL",5)
	MakeGlobalOverride()
  END